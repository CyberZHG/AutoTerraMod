Configs: {
	AutoTerraConfig: {
		DisplayName: Auto Terra Factions

		BotsEnabled: {
			Label: Enable bots
			Tooltip: Turn AI factions on or off in this world. Off hides bots but keeps them saved.
		}

		FactionCount: {
			Label: Faction count
			Tooltip: Number of AI factions (1-6). Lowering it hides the extra ones.
		}

		BotsPerFaction: {
			Label: Bots per faction
			Tooltip: Bots in each faction (1-20). Lowering it hides the extra ones.
		}

		Relation: {
			Label: Faction relation
			Tooltip: Race: separate knowledge. Cooperate: shared discoveries. War: factions fight each other.
		}

		ShowInfoPanel: {
			Label: Show faction/bot info panel
			Tooltip: Left panel with faction progress and the followed bot.
		}

		SpectatorMode: {
			Label: Spectator mode
			Tooltip: Become an untargetable ghost; the camera follows bots.
		}

		DiagnosticLogging: {
			Label: Diagnostic logging
			Tooltip: Log bot task and plan changes to client.log.
		}

		WorkbenchBossSummons: {
			Label: Craft boss summons at a work bench
			Tooltip: Boss summoning items that need a demon or crimson altar can also be crafted at a work bench.
		}
	}

	FactionRelation: {
		Race: {
			Label: Race
			Tooltip: ""
		}

		Cooperate: {
			Label: Cooperate
			Tooltip: ""
		}

		War: {
			Label: War
			Tooltip: ""
		}

		Tooltip: ""
	}
}

Commands: {
	Description: Shows or changes this world's faction settings (lowering a count hides bots, keeping them in the save)
	NotStarted: Factions have not started in this world yet.
	Usage: Usage: {0}
	Current: This world: bots {3}, {0} factions, {1} bots each, relation: {2}, material drops {4}x
	On: on
	Off: off
}

