Configs: {
	AutoTerraConfig: {
		DisplayName: Auto Terra Factions

		FactionCount: {
			Label: Faction count
			Tooltip: Number of AI factions used when a new world starts (1-4). Afterwards each world keeps its own settings; change them in game with /autoterra.
		}

		BotsPerFaction: {
			Label: Bots per faction
			Tooltip: Number of AI bots per faction used when a new world starts (1-6). Afterwards each world keeps its own settings; change them in game with /autoterra.
		}

		Relation: {
			Label: Faction relation
			Tooltip: Used when a new world starts. Race keeps knowledge separate; Cooperate shares discovered resources between factions; War lets factions fight each other but never wreck or rob each other's bases. Change it later with /autoterra relation.
		}

		ShowInfoPanel: {
			Label: Show faction/bot info panel
			Tooltip: Shows the panel on the left with faction progress and the followed bot's details.
		}

		SpectatorMode: {
			Label: Spectator mode
			Tooltip: Turns you into an untargetable ghost and lets the camera follow bots.
		}

		DiagnosticLogging: {
			Label: Diagnostic logging
			Tooltip: Writes each bot's task and plan changes to client.log.
		}
	}

	FactionRelation: {
		Race: {
			Label: Race
			Tooltip: ""
		}

		Cooperate: {
			Label: Cooperate
			Tooltip: ""
		}

		War: {
			Label: War
			Tooltip: ""
		}

		Tooltip: ""
	}
}

Commands: {
	Description: Shows or changes this world's faction settings (counts can only grow)
	NotStarted: Factions have not started in this world yet.
	Usage: Usage: {0}
	Current: This world: {0} factions, {1} bots each, relation: {2}
}

