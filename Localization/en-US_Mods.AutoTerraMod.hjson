Configs: {
	AutoTerraConfig: {
		DisplayName: Auto Terra Factions

		FactionCount: {
			Label: Faction count
			Tooltip: Number of AI factions created when a world is first entered (1-4).
		}

		BotsPerFaction: {
			Label: Bots per faction
			Tooltip: Number of AI bots in each faction (1-6).
		}

		Relation: {
			Label: Faction relation
			Tooltip: Race keeps knowledge separate; Cooperate shares discovered resources between factions.
		}

		SpectatorMode: {
			Label: Spectator mode
			Tooltip: Turns you into an untargetable ghost and lets the camera follow bots.
		}

		DiagnosticLogging: {
			Label: Diagnostic logging
			Tooltip: Writes each bot's task and plan changes to client.log.
		}
	}

	FactionRelation: {
		Race: {
			Label: Race
			Tooltip: ""
		}

		Cooperate: {
			Label: Cooperate
			Tooltip: ""
		}

		Tooltip: ""
	}
}

