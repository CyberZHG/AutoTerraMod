Configs: {
	AutoTerraConfig: {
		DisplayName: 自动NPC与阵营

		BotsEnabled: {
			Label: 开启 AI 角色
			Tooltip: 开关本世界的 AI 阵营。关闭时角色隐藏但保留存档。
		}

		FactionCount: {
			Label: 阵营数量
			Tooltip: AI 阵营数（1-6）。调小时多出的阵营会隐藏。
		}

		BotsPerFaction: {
			Label: 每阵营人数
			Tooltip: 每个阵营的角色数（1-20）。调小时多出的角色会隐藏。
		}

		Relation: {
			Label: 阵营关系
			Tooltip: 竞速：情报独立；合作：共享发现；敌对：互相攻击。
		}

		ShowInfoPanel: {
			Label: 显示阵营/角色信息面板
			Tooltip: 左侧显示阵营进度和跟随角色信息。
		}

		SpectatorMode: {
			Label: 观战模式
			Tooltip: 变成不被攻击的幽灵，镜头跟随角色。
		}

		DiagnosticLogging: {
			Label: 诊断日志
			Tooltip: 把角色任务和计划变化写入 client.log。
		}

		WorkbenchBossSummons: {
			Label: 在工作台合成Boss召唤物
			Tooltip: 原本需要恶魔祭坛或猩红祭坛的Boss召唤物在开启了bot的地图里也可以在工作台合成。
		}

		ImportBotsFrom: {
			Label: 从其他地图导入bot
			Tooltip:
				'''
				点击选择另一个地图（右键往回选），然后保存。把那个地图里所有显示中的阵营和bot连同物品栏和装备复制到当前地图。
				当前地图原有的阵营、bot和阵营记录会被替换，阵营数和每队人数改成和来源一致。不复制仓库箱子，也不会改动来源地图。
				'''
		}
	}

	FactionRelation: {
		Race: {
			Label: 竞速
			// Tooltip: ""
		}

		Cooperate: {
			Label: 合作
			// Tooltip: ""
		}

		War: {
			Label: 敌对
			// Tooltip: ""
		}

		// Tooltip: ""
	}
}

Commands: {
	Description: 查看或修改当前世界的阵营设置（调小时多出的角色会隐藏，仍保留在存档中）
	NotStarted: 当前世界还没有开始阵营。
	Usage: 用法：{0}
	Current: 当前世界：AI 角色{3}，{0} 个阵营，每阵营 {1} 人，关系：{2}，材料掉落 {4} 倍
	On: 开启
	Off: 关闭
}

